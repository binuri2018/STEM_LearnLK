# Copy to .env and fill in.

# OpenAI: chat, embeddings (if EMBEDDING_PROVIDER=openai), Whisper, and TTS.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# sentence-transformers (local) vs openai embeddings for FAISS ingest + queries
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai

# Local embedding model name (when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# If downloads still fail, dev-only (not for production):
# BINURI_DISABLE_SSL_VERIFY=1
# ... patches Python ssl + Hugging Face Hub httpx so model files can download.


# Local LLM via Ollama — used when OPENAI_API_KEY is empty (chat only; Whisper/TTS still need OpenAI).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=600

RESOURCE_DIR=Resource
DATA_DIR=data

# Narrative Learning (separate from Voice Tutor FAISS)
# LLM_PROVIDER=groq | ollama | openrouter
LLM_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_API_KEY=
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
# Leave empty to use backend/components/narrative_learning/science_vector_db
# or a sibling "../STEM TEXT/science_vector_db" folder.
NARRATIVE_VECTOR_DB=
